---
import SiteFooter from "../components/site/SiteFooter.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import type { Release } from "../data/releases/schema";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
  release?: Release;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = "/social/vulnbench-default.svg",
  release,
} = Astro.props;
const site = Astro.site ?? new URL("https://vulnbench.com");
const canonicalUrl = new URL(canonicalPath, site);
const imageUrl = new URL(image, site);
const documentTitle =
  title === "Snyk VulnBench" ? title : `${title} | Snyk VulnBench`;
const articleStructuredData = release
  ? {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      headline: release.citation.title,
      datePublished: release.publishedAt,
      dateModified: release.updatedAt,
      author: release.citation.authors.map((name) => ({
        "@type": "Person",
        name,
        affiliation: { "@type": "Organization", name: "Snyk" },
      })),
      url: release.citation.url,
      mainEntityOfPage: canonicalUrl.toString(),
      isAccessibleForFree: true,
      publisher: { "@type": "Organization", name: "Snyk" },
    }
  : undefined;
const datasetStructuredData = release
  ? {
      "@context": "https://schema.org",
      "@type": "Dataset",
      name: `${release.name} dataset`,
      description: release.description,
      version: release.datasetVersion,
      datePublished: release.publishedAt,
      dateModified: release.updatedAt,
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      creator: { "@type": "Organization", name: "Snyk" },
      isAccessibleForFree: true,
      distribution: release.assets.map((asset) => ({
        "@type": "DataDownload",
        encodingFormat:
          asset.format === "jsonl"
            ? "application/x-ndjson"
            : asset.format === "csv"
              ? "text/csv"
              : "application/json",
        contentUrl: new URL(asset.path, site).toString(),
      })),
    }
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="theme-color" content="#f7f4ed" />
    <script is:inline>
      (() => {
        const storageKey = "vulnbench-theme";
        const themeColors = {
          light: "#f7f4ed",
          dark: "#211e24",
        };
        let theme;

        try {
          const savedTheme = localStorage.getItem(storageKey);
          if (savedTheme === "light" || savedTheme === "dark") {
            theme = savedTheme;
          }
        } catch {}

        if (!theme) {
          try {
            theme = matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          } catch {
            theme = "light";
          }
        }

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;

        try {
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", themeColors[theme]);
        } catch {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{documentTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Snyk VulnBench" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {
      release && (
        <>
          <meta name="citation_title" content={release.citation.title} />
          {release.citation.authors.map((author) => (
            <meta name="citation_author" content={author} />
          ))}
          <meta
            name="citation_publication_date"
            content={release.publishedAt}
          />
          <meta name="citation_pdf_url" content={release.links.paper} />
          <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(articleStructuredData)}
          />
          <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(datasetStructuredData)}
          />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
