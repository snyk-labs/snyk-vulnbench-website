---
import type { v20Copy } from "../../data/releases/2.0-content";
import FigureGroup from "./FigureGroup.astro";

type Section = (typeof v20Copy.releasePage)[number];

interface Props {
  section: Section;
  muted?: boolean;
}

const { section, muted = false } = Astro.props;
const figures = section.figures ?? (section.figure ? [section.figure] : []);
const titleId = `${section.id}-title`;
---

<section
  class:list={["section", "release-section", { "release-section--muted": muted }]}
  id={section.id}
  aria-labelledby={titleId}
>
  <div class="container">
    <div class="release-section__text">
      <p class="eyebrow">{section.kicker}</p>
      <h2 id={titleId}>{section.h2}</h2>
      {section.body?.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <slot />
    {figures.length > 0 && <FigureGroup figures={figures} />}
    {
      section.items && (
        <ol class="release-section__items">
          {section.items.map(({ title, text }, index) => (
            <li>
              <span class="metric">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))}
        </ol>
      )
    }
    {section.boundary && <p class="release-section__boundary">{section.boundary}</p>}
  </div>
</section>

<style>
  .release-section--muted {
    background: var(--paper-muted);
  }

  .release-section .container {
    display: grid;
    min-width: 0;
    gap: var(--space-5);
  }

  .release-section .container > :global(*) {
    min-width: 0;
  }

  .release-section__text {
    display: grid;
    max-width: 50rem;
    gap: var(--space-3);
  }

  .release-section__text h2 {
    max-width: 22ch;
  }

  .release-section__items {
    display: grid;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .release-section__items li {
    display: grid;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
    gap: var(--space-3);
    grid-template-columns: 2.5rem 1fr;
  }

  .release-section__items .metric {
    color: var(--purple-dark);
    font-size: var(--step--1);
    font-weight: var(--font-weight-metric);
  }

  .release-section__items h3 {
    font-size: var(--step-1);
  }

  .release-section__items p {
    max-width: 45rem;
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  .release-section__boundary {
    max-width: 50rem;
    padding-left: var(--space-3);
    border-left: 0.2rem solid var(--warning);
  }
</style>
