---
import { v20Copy } from "../../data/releases/2.0-content";

interface Props {
  form: "short" | "long";
}

const { form } = Astro.props;
---

<aside class="disclosure" aria-label="Disclosure" data-disclosure={form}>
  <p>{v20Copy.disclosure[form]}</p>
</aside>

<style>
  .disclosure {
    max-width: 48rem;
    padding: var(--space-3) var(--space-4);
    border-left: 0.25rem solid var(--ink);
    background: var(--paper-raised);
  }

  .disclosure p {
    color: var(--ink);
    font-size: var(--step-0);
    line-height: 1.6;
  }
</style>
