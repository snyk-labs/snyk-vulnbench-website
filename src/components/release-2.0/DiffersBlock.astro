---
import { v20Copy } from "../../data/releases/2.0-content";

const { differs } = v20Copy;
---

<section class="section differs" id="differs" aria-labelledby="differs-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">How 2.0 differs from JS 1.0</p>
      <h2 id="differs-title">{differs.h2}</h2>
      <p class="lede">{differs.intro}</p>
    </div>
    <div class="differs__scroll" tabindex="0" role="region" aria-label={differs.h2}>
      <table>
        <caption>Snyk VulnBench JS 1.0 and Snyk VulnBench 2.0, aspect by aspect</caption>
        <thead>
          <tr>
            <th scope="col">Aspect</th>
            <th scope="col">Snyk VulnBench JS 1.0</th>
            <th scope="col">Snyk VulnBench 2.0</th>
          </tr>
        </thead>
        <tbody>
          {
            differs.rows.map(({ aspect, js10, v20 }) => (
              <tr>
                <th scope="row">{aspect}</th>
                <td>{js10}</td>
                <td>{v20}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="differs__boundary">{differs.boundary}</p>
  </div>
</section>

<style>
  .differs {
    background: var(--paper-muted);
  }

  .differs__scroll {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--rule-strong);
    background: var(--paper-raised);
  }

  table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    text-align: left;
  }

  caption {
    padding: 0.6rem 0.75rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: left;
  }

  th,
  td {
    padding: var(--space-3);
    border-top: 1px solid var(--rule);
    vertical-align: top;
  }

  thead th {
    background: var(--paper-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  tbody th {
    font-weight: var(--font-weight-label-strong);
  }

  .differs__boundary {
    max-width: 48rem;
    padding-left: var(--space-3);
    margin-top: var(--space-4);
    border-left: 0.2rem solid var(--warning);
  }
</style>
