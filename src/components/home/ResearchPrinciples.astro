---
import { releases } from "../../data/releases";
import { v20Copy } from "../../data/releases/2.0-content";

const { principles, release_history, release_history_note } = v20Copy.home;
const history = release_history.map((entry) => {
  const release = releases.find(({ name }) => name === entry.name);
  if (!release) throw new Error(`Release history names an unknown release: ${entry.name}`);
  return { ...entry, href: release.links.overview };
});
---

<section class="section" aria-labelledby="principles-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">{principles.kicker}</p>
      <h2 id="principles-title">{principles.h2}</h2>
      <p class="lede">{principles.body}</p>
    </div>

    <dl class="principles">
      {
        principles.items.map(({ title, text }) => (
          <div>
            <dt>{title}</dt>
            <dd>{text}</dd>
          </div>
        ))
      }
    </dl>

    <div class="release-note">
      <p class="eyebrow">Release history</p>
      <ol class="release-history">
        {
          history.map(({ name, line, href }) => (
            <li>
              <a href={href}>
                <strong>{name}</strong>
              </a>
              <span>{line}</span>
            </li>
          ))
        }
      </ol>
      <p>{release_history_note}</p>
      <a class="text-link" href="/releases">View release catalog</a>
    </div>
  </div>
</section>

<style>
  .principles {
    display: grid;
    padding: 0;
    margin: 0;
    border-block: 1px solid var(--ink);
  }

  .principles div {
    display: grid;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
    gap: var(--space-2);
  }

  .principles div:last-child {
    border-bottom: 0;
  }

  dt {
    font-weight: var(--font-weight-label-strong);
  }

  dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .release-note {
    display: grid;
    padding-top: var(--space-6);
    margin-top: var(--space-6);
    border-top: 0.3rem solid var(--purple);
    gap: var(--space-3);
  }

  .release-history {
    display: grid;
    padding: 0;
    margin: 0;
    gap: var(--space-3);
    list-style: none;
  }

  .release-history li {
    display: grid;
  }

  .release-note span,
  .release-note > p:not(.eyebrow) {
    color: var(--ink-soft);
  }

  .release-note .text-link {
    width: fit-content;
  }

  @media (min-width: 48rem) {
    .principles div {
      grid-template-columns: minmax(13rem, 0.75fr) 1.25fr;
    }

    .release-note {
      grid-template-columns: 0.55fr 1fr 1.3fr auto;
      align-items: start;
    }
  }
</style>
