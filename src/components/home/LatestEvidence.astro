---
import { getHeadlineEvidence } from "../../data/releases/headline";

const evidence = getHeadlineEvidence("js-1.0");
const percentage = (numerator: number, denominator: number) =>
  `${((numerator / denominator) * 100).toFixed(1)}%`;
const observations = [
  {
    value: "5.67×",
    label:
      "Opus 4.7 Max cost more and scored lower than Opus 4.6 Medium: 68.8% vs 75.4% Snyk-reference F1.",
    href: "/releases/js-1.0/explore?view=efficiency",
    tone: "cost",
  },
  {
    value: percentage(
      evidence.unmatchedOnce.numerator,
      evidence.unmatchedOnce.denominator,
    ),
    label: "Nearly half of unmatched reports surfaced in just one run.",
    href: evidence.unmatchedOnce.explorerPath,
    tone: "unmatched",
  },
  {
    value: percentage(
      evidence.unmatchedAllFive.numerator,
      evidence.unmatchedAllFive.denominator,
    ),
    label: "Only 13.7% of unmatched reports recurred in all five runs.",
    href: evidence.unmatchedAllFive.explorerPath,
    tone: "unmatched-outline",
  },
];
---

<section class="evidence-band" aria-labelledby="latest-evidence-title">
  <div class="container">
    <div class="band-heading">
      <p class="eyebrow">Latest evidence · JS 1.0</p>
      <h2 id="latest-evidence-title">Same code. Same prompt. Different findings.</h2>
      <p>
        Across five identical runs, 84.8% of reference-matched findings recurred
        every time. Nearly half of unmatched reports appeared only once—evidence
        to inspect, not dismiss.
      </p>
    </div>

    <div class="observations">
      {
        observations.map(({ value, label, href, tone }) => (
          <a class={`observation ${tone}`} href={href}>
            <span class="metric">{value}</span>
            <span>{label}</span>
            <small>Inspect evidence →</small>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .evidence-band {
    padding-block: var(--space-7);
    background: var(--evidence-surface);
    color: var(--evidence-text);
  }

  .band-heading {
    display: grid;
    max-width: 55rem;
    margin-bottom: var(--space-6);
    gap: var(--space-3);
  }

  .band-heading .eyebrow {
    color: var(--evidence-accent);
  }

  .band-heading p:last-child {
    max-width: 48rem;
    color: var(--evidence-muted);
  }

  .observations {
    display: grid;
    border-block: 1px solid var(--evidence-rule);
  }

  .observation {
    display: grid;
    padding: var(--space-4);
    border-bottom: 1px solid var(--evidence-rule);
    color: inherit;
    gap: var(--space-2);
    text-decoration: none;
  }

  .observation:last-child {
    border-bottom: 0;
  }

  .observation:hover {
    background: var(--evidence-hover);
  }

  .observation .metric {
    font-size: var(--step-2);
    font-weight: var(--font-weight-metric);
  }

  .observation.cost .metric {
    color: var(--evidence-matched);
  }

  .observation.unmatched .metric,
  .observation.unmatched-outline .metric {
    color: var(--evidence-unmatched);
  }

  .observation small {
    color: var(--evidence-muted);
    font-weight: var(--font-weight-control);
  }

  @media (min-width: 48rem) {
    .observations {
      grid-template-columns: repeat(3, 1fr);
    }

    .observation {
      min-height: 13rem;
      border-right: 1px solid var(--evidence-rule);
      border-bottom: 0;
      align-content: space-between;
    }

    .observation:last-child {
      border-right: 0;
    }
  }
</style>
