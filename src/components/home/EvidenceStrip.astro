---
import type { Release } from "../../data/releases/schema";

interface Props {
  evidence: Release["evidence"];
}

const { evidence } = Astro.props;
const items = [
  { value: evidence.scans, label: "scans" },
  { value: evidence.projects, label: "projects" },
  { value: evidence.configurations, label: "configurations" },
  { value: evidence.repetitions, label: "repetitions" },
];
---

<dl class="evidence-strip" aria-label="Benchmark scope">
  {
    items.map(({ value, label }) => (
      <div>
        <dt class="metric">{value}</dt>
        <dd>{label}</dd>
      </div>
    ))
  }
</dl>

<style>
  .evidence-strip {
    display: grid;
    padding: 0;
    margin: 0;
    border-block: 1px solid var(--rule-strong);
    grid-template-columns: repeat(2, 1fr);
  }

  .evidence-strip div {
    padding: 0.8rem 0.9rem;
    border-right: 1px solid var(--rule);
  }

  .evidence-strip div:nth-child(2n) {
    border-right: 0;
  }

  .evidence-strip div:nth-child(-n + 2) {
    border-bottom: 1px solid var(--rule);
  }

  dt {
    color: var(--ink);
    font-size: var(--step-1);
    font-weight: var(--font-weight-metric);
    line-height: 1.1;
  }

  dd {
    margin: 0.2rem 0 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  @media (min-width: 35rem) {
    .evidence-strip {
      grid-template-columns: repeat(4, 1fr);
    }

    .evidence-strip div:nth-child(2n) {
      border-right: 1px solid var(--rule);
    }

    .evidence-strip div:last-child {
      border-right: 0;
    }

    .evidence-strip div:nth-child(-n + 2) {
      border-bottom: 0;
    }
  }
</style>
