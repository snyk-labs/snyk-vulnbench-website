---
import { requireReleaseBySlug } from "../../data/releases";
import { v20Copy } from "../../data/releases/2.0-content";

interface Props {
  full?: boolean;
}

const { full = false } = Astro.props;
const release = requireReleaseBySlug("2.0");
const intro = v20Copy.home.findings_intro;
const findings = v20Copy.findings.map((finding, index) => ({
  ...finding,
  body: full ? finding.body : finding.body.slice(0, 1),
  explorerPath: release.featuredFindings[index]?.explorerPath ?? release.links.explore,
}));
---

<section class="section" id="findings" aria-labelledby="findings-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">{intro.kicker}</p>
      <h2 id="findings-title">{intro.h2}</h2>
      <p class="lede">{intro.body}</p>
    </div>

    <ol class="findings">
      {
        findings.map(({ n, title, body, care, explorerPath }) => (
          <li>
            <span class="finding-number metric">{n}</span>
            <div>
              <h3>{title}</h3>
              {body.map((paragraph) => <p>{paragraph}</p>)}
              <p class="caveat">
                <strong>Interpret with care:</strong> {care}
              </p>
            </div>
            <a class="text-link" href={explorerPath}>
              Open the evidence
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .findings {
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .findings li {
    display: grid;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--rule);
    gap: var(--space-3);
  }

  .finding-number {
    color: var(--purple-dark);
    font-size: var(--step--1);
    font-weight: var(--font-weight-metric-compact);
  }

  h3 {
    max-width: 39rem;
    font-size: var(--step-2);
  }

  h3 ~ p:not(.caveat) {
    max-width: 47rem;
    margin-top: var(--space-3);
    color: var(--ink-soft);
  }

  .caveat {
    max-width: 47rem;
    padding-left: var(--space-3);
    margin-top: var(--space-3);
    border-left: 2px solid var(--warning);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .text-link {
    width: fit-content;
  }

  @media (min-width: 48rem) {
    .findings li {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      align-items: start;
    }
  }
</style>
