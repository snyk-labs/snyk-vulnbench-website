---
/* snyk-2026-audit:start */
import { isSnyk2026Design } from "../../config/design-theme";
/* snyk-2026-audit:end */
import { currentRelease } from "../../data/releases";
import { v20Copy } from "../../data/releases/2.0-content";
import DataTable from "../release-2.0/DataTable.astro";
import Disclosure from "../release-2.0/Disclosure.astro";
import PaperFigure from "../release-2.0/PaperFigure.astro";
import { scorecardSpecs } from "../release-2.0/evidence-tables";
import BrandFabric from "../site/BrandFabric.astro";
import EvidenceStrip from "./EvidenceStrip.astro";

const { home } = v20Copy;
const [releaseKicker, releaseName] = home.current_release_label.split(" · ");
const [exploreLabel, paperLabel, methodologyLabel, dataLabel] = home.buttons;
---

<section class="hero">
  <!-- snyk-2026-audit:start -->
  {isSnyk2026Design && <BrandFabric />}
  {
    isSnyk2026Design && (
      <div class="brand-gradient-accent" aria-hidden="true" />
    )
  }
  <!-- snyk-2026-audit:end -->

  <div class="hero-grid container">
    <div class="hero-copy">
      <div class="release-line">
        <span class="release-kicker">{releaseKicker}</span>
        <a href={currentRelease.links.overview}>{releaseName}</a>
      </div>

      <p class="eyebrow">{home.eyebrow}</p>
      <h1>{home.h1}</h1>
      <p class="study-label">{home.subtitle}</p>
      <p class="lede">{home.lede}</p>

      <div class="button-row">
        <a class="button" href={currentRelease.links.explore}>{exploreLabel}</a>
        <a class="button secondary" href={currentRelease.links.paper}>{paperLabel}</a>
      </div>

      <div class="secondary-links">
        <a href={currentRelease.links.methodology}>{methodologyLabel}</a>
        <a href={currentRelease.links.data}>{dataLabel}</a>
      </div>

      <Disclosure form="short" />

      <EvidenceStrip items={home.stats} />
    </div>

    <div class="hero-visual">
      <div class="visual-heading">
        <div>
          <p class="eyebrow">{home.headline_evidence.kicker}</p>
          <h2>{home.headline_evidence.h2}</h2>
        </div>
        <span class="metric">2.0</span>
      </div>
      <PaperFigure number={1} scheme={isSnyk2026Design ? "dark" : "auto"} loading="eager" />
      <ul class="callouts">
        {home.headline_evidence.callouts.map((callout) => <li>{callout}</li>)}
      </ul>
      <p class="for-appsec">{home.headline_evidence.for_appsec}</p>
      <p class="visual-scope">{home.headline_evidence.dataset_line}</p>
      {scorecardSpecs().map((spec) => <DataTable {...spec} id={`hero-${spec.id}`} />)}
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-5) var(--space-7);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: var(--space-6);
  }

  /* snyk-2026-audit:start */
  :global(html[data-design-theme="snyk-2026"]) .hero {
    position: relative;
    isolation: isolate;
    padding-bottom: clamp(6rem, 12vw, 10rem);
  }

  :global(html[data-design-theme="snyk-2026"]) .hero-grid {
    position: relative;
    z-index: 1;
  }

  :global(html[data-design-theme="snyk-2026"]) .hero-copy {
    max-width: 40rem;
    text-align: left;
  }

  :global(html[data-design-theme="snyk-2026"][data-theme="light"])
    .hero-copy {
    background: #FFFFFF;
    color: #030328;
  }

  :global(html[data-design-theme="snyk-2026"]:not([data-theme]))
    .hero-copy {
    background: #FFFFFF;
    color: #030328;
  }

  :global(html[data-design-theme="snyk-2026"]) .brand-gradient-accent {
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    left: 0;
    height: 0.3rem;
    background: var(--brand-gradient);
  }

  :global(html[data-design-theme="snyk-2026"][data-theme="dark"])
    .brand-gradient-accent {
    height: 1px;
  }

  :global(html[data-design-theme="snyk-2026"]) .hero h1 {
    max-width: 20ch;
    font-size: clamp(2rem, 3.8vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.98;
    overflow-wrap: break-word;
  }

  :global(html[data-design-theme="snyk-2026"]) .hero-visual {
    --paper-raised: #030328;
    --paper-muted: #2B0250;
    --ink: #FFFFFF;
    --ink-soft: rgba(255, 255, 255, 0.78);
    --ink-faint: rgba(255, 255, 255, 0.65);
    --rule: rgba(255, 255, 255, 0.12);
    --rule-strong: rgba(255, 255, 255, 0.4);
    --purple-dark: #FF00FF;
    --action-link: #FF00FF;
    border-top: 1px solid #6F00DD;
    border-right: 1px solid #FE9104;
    border-bottom: 1px solid #F3552E;
    border-left: 1px solid #FF00FF;
    background: #030328;
    color: #FFFFFF;
  }

  :global(html[data-design-theme="snyk-2026"][data-theme="dark"])
    .hero-visual {
    --paper-raised: rgba(255, 255, 255, 0.08);
    --paper-muted: rgba(255, 255, 255, 0.04);
    --ink: rgba(255, 255, 255, 0.78);
    --ink-soft: rgba(255, 255, 255, 0.65);
    --ink-faint: rgba(255, 255, 255, 0.5);
    --rule: rgba(255, 255, 255, 0.12);
    --rule-strong: rgba(255, 255, 255, 0.4);
    --action-link: rgba(255, 255, 255, 0.78);
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.78);
  }

  :global(html[data-design-theme="snyk-2026"][data-theme="dark"])
    .study-label {
    color: rgba(255, 255, 255, 0.78);
  }
  /* snyk-2026-audit:end */

  .hero-copy {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .release-line {
    display: flex;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    gap: var(--space-3);
    justify-content: space-between;
  }

  .release-kicker {
    color: var(--purple-dark);
    font-weight: var(--font-weight-label, 700);
  }

  h1 {
    max-width: 22ch;
    font-size: var(--step-3);
  }

  .study-label {
    width: fit-content;
    padding: 0.35rem 0.6rem;
    border-left: 0.25rem solid var(--purple);
    background: var(--purple-soft);
    color: var(--purple-dark);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--font-weight-label, 700);
  }

  .secondary-links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    font-size: var(--step--1);
    font-weight: var(--font-weight-control, 700);
  }

  .hero-visual {
    padding: var(--space-4);
    border: 1px solid var(--ink);
    background: var(--paper-muted);
  }

  .visual-heading {
    display: flex;
    padding-bottom: var(--space-4);
    gap: var(--space-3);
    align-items: start;
    justify-content: space-between;
  }

  .visual-heading h2 {
    margin-top: 0.25rem;
    font-size: var(--step-2);
  }

  .visual-heading > .metric {
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--rule-strong);
    background: var(--paper-raised);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  .hero-visual {
    display: grid;
    min-width: 0;
    gap: var(--space-4);
  }

  .hero-visual > :global(*) {
    min-width: 0;
  }

  .hero-visual :global(.paper-figure) {
    margin: 0;
  }

  .visual-heading {
    padding-bottom: 0;
  }

  .callouts {
    display: grid;
    padding-left: 1.1rem;
    margin: 0;
    gap: var(--space-2);
    font-size: var(--step--1);
  }

  .for-appsec {
    padding-left: var(--space-3);
    border-left: 0.2rem solid var(--warning);
    font-size: var(--step--1);
  }

  .visual-scope {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  @media (min-width: 62rem) {
    .hero {
      padding-block: var(--space-6) var(--space-8);
    }

    .hero-grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(29rem, 1.08fr);
      align-items: start;
    }

    .hero-visual {
      margin-top: var(--space-5);
    }
  }
</style>
