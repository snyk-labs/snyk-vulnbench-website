---
import { currentRelease, releases } from "../../data/releases";
import ReleaseCitation from "../site/ReleaseCitation.astro";
---

<section class="publication" aria-labelledby="publication-title">
  <div class="container publication-grid">
    <div>
      <p class="eyebrow">Publication</p>
      <h2 id="publication-title">Read, reproduce, and cite the work</h2>
      <p class="lede">
        The paper, reviewed methodology, source snapshot, and release data use
        stable public links.
      </p>
      <nav aria-label="Publication links">
        <a class="button" href={currentRelease.links.paper}>Read the paper</a>
        <a class="button secondary" href={currentRelease.links.github}
          >View GitHub</a
        >
        <a class="button secondary" href={currentRelease.links.data}
          >Download data</a
        >
      </nav>
    </div>

    <div class="citations">
      <p class="eyebrow">Preferred citation</p>
      {releases.map((release) => <ReleaseCitation release={release} />)}
    </div>
  </div>
</section>

<style>
  .publication {
    padding-block: var(--space-7);
    border-top: 1px solid var(--ink);
    background: var(--purple-soft);
  }

  .publication-grid {
    display: grid;
    gap: var(--space-6);
  }

  .publication-grid > * {
    min-width: 0;
  }

  .publication h2 {
    max-width: 18ch;
    margin-top: var(--space-2);
  }

  .publication .lede {
    max-width: 42rem;
    margin-top: var(--space-3);
  }

  .citations {
    display: grid;
    gap: var(--space-4);
  }

  nav {
    display: flex;
    margin-top: var(--space-5);
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  @media (min-width: 60rem) {
    .publication-grid {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }
</style>
