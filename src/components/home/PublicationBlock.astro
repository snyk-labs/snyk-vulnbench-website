---
import { currentRelease } from "../../data/releases";
import { formatBibtexCitation } from "../../data/releases/citation";

const citation = formatBibtexCitation(currentRelease);
---

<section class="publication" aria-labelledby="publication-title">
  <div class="container publication-grid">
    <div>
      <p class="eyebrow">Publication</p>
      <h2 id="publication-title">Read, reproduce, and cite the work</h2>
      <p class="lede">
        The paper, reviewed methodology, source snapshot, and release data use
        stable public links.
      </p>
    </div>

    <div class="citation">
      <p class="eyebrow">Preferred citation</p>
      <div class="citation-source" data-bibtex-citation>
        <pre><code>{citation}</code></pre>
        <div class="citation-actions">
          <button class="button secondary" type="button" data-copy-bibtex>
            Copy BibTeX
          </button>
          <span data-citation-status aria-live="polite"></span>
        </div>
      </div>
      <p class="authors">
        Liran Tal · Johannes Kloos · Arsenii Rudich · Stephen Thoemmes · Manoj
        Nair
      </p>
    </div>

    <nav aria-label="Publication links">
      <a class="button" href={currentRelease.links.paper}>Read the paper</a>
      <a class="button secondary" href={currentRelease.links.publication}
        >Snyk publication</a
      >
      <a class="button secondary" href={currentRelease.links.github}
        >View GitHub</a
      >
      <a
        class="button secondary"
        href="https://github.com/snyk-labs/snyk-vulnbench"
        >Benchmark Harness</a
      >
      <a class="button secondary" href={currentRelease.links.data}
        >Download data</a
      >
    </nav>
  </div>
</section>

<style>
  .publication {
    padding-block: var(--space-7);
    border-top: 1px solid var(--ink);
    background: var(--purple-soft);
  }

  .publication-grid {
    display: grid;
    gap: var(--space-6);
  }

  .publication h2 {
    max-width: 18ch;
    margin-top: var(--space-2);
  }

  .publication .lede {
    max-width: 42rem;
    margin-top: var(--space-3);
  }

  .citation {
    padding: var(--space-4);
    border: 1px solid var(--purple);
    background: var(--paper-raised);
  }

  .citation-source pre {
    margin: var(--space-3) 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .citation-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  [data-citation-status] {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .authors {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  nav {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  @media (min-width: 60rem) {
    .publication-grid {
      grid-template-columns: 1.1fr 1fr 0.6fr;
      align-items: start;
    }
  }
</style>

<script>
  let copiedStatusTimeout: number | undefined;

  document.querySelectorAll<HTMLButtonElement>("[data-copy-bibtex]").forEach((button) => {
    button.addEventListener("click", async () => {
      const source = button.closest<HTMLElement>("[data-bibtex-citation]");
      const code = source?.querySelector("code");
      const status = source?.querySelector<HTMLElement>("[data-citation-status]");
      const citation = code?.textContent;

      if (!citation || !navigator.clipboard?.writeText) {
        window.clearTimeout(copiedStatusTimeout);
        if (status) status.textContent = "Select and copy the BibTeX entry manually.";
        return;
      }

      try {
        await navigator.clipboard.writeText(citation);
        if (status) {
          window.clearTimeout(copiedStatusTimeout);
          status.textContent = "Copied";
          copiedStatusTimeout = window.setTimeout(() => {
            if (status.textContent === "Copied") status.textContent = "";
          }, 3_000);
        }
      } catch {
        window.clearTimeout(copiedStatusTimeout);
        if (status) status.textContent = "Select and copy the BibTeX entry manually.";
      }
    });
  });
</script>
