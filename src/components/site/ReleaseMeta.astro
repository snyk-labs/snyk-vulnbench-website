---
import type { Release } from "../../data/releases/schema";

interface Props {
  release: Release;
}

const { release } = Astro.props;
---

<dl class="release-meta">
  <div>
    <dt>Status</dt>
    <dd>{release.status}</dd>
  </div>
  <div>
    <dt>Published</dt>
    <dd><time datetime={release.publishedAt}>11 June 2026</time></dd>
  </div>
  <div>
    <dt>Dataset</dt>
    <dd class="metric">{release.datasetVersion}</dd>
  </div>
  <div>
    <dt>Protocol</dt>
    <dd>JS 1.0</dd>
  </div>
</dl>

<style>
  .release-meta {
    display: grid;
    padding: 0;
    margin: 0;
    gap: var(--space-3);
    grid-template-columns: repeat(2, 1fr);
  }

  .release-meta div {
    display: grid;
    gap: 0.1rem;
  }

  dt {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: capitalize;
  }
</style>
