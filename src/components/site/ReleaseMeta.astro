---
import type { Release } from "../../data/releases/schema";

interface Props {
  release: Release;
}

const { release } = Astro.props;
const date = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<div class="release-meta-panel">
  <dl class="release-meta">
    <div>
      <dt>Status</dt>
      <dd>{release.status}</dd>
    </div>
    <div>
      <dt>Published</dt>
      <dd>
        <time datetime={release.publishedAt}
          >{date.format(new Date(`${release.publishedAt}T00:00:00Z`))}</time
        >
      </dd>
    </div>
    <div>
      <dt>Dataset</dt>
      <dd class="metric">{release.datasetVersion}</dd>
    </div>
    <div>
      <dt>Last updated</dt>
      <dd>
        <time datetime={release.updatedAt}
          >{date.format(new Date(`${release.updatedAt}T00:00:00Z`))}</time
        >
      </dd>
    </div>
  </dl>

  <nav aria-label="Release metadata links">
    <a href={release.links.paper}>Paper</a>
    <a href={release.links.publication}>Snyk publication</a>
    <a href={release.links.github}>GitHub</a>
    <a href={`${release.links.data}#corrections`}>Correction history</a>
    <a href="/about#citation">Cite this release</a>
  </nav>
</div>

<style>
  .release-meta-panel {
    display: grid;
    gap: var(--space-4);
  }

  .release-meta {
    display: grid;
    padding: 0;
    margin: 0;
    gap: var(--space-3);
    grid-template-columns: repeat(2, 1fr);
  }

  .release-meta div {
    display: grid;
    gap: 0.1rem;
  }

  dt {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: capitalize;
  }

  nav {
    display: flex;
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule-strong);
    gap: var(--space-2) var(--space-3);
    flex-wrap: wrap;
    font-size: var(--step--1);
    font-weight: 700;
  }

  nav a {
    display: inline-flex;
    min-height: 2rem;
    padding-inline: 0.15rem;
    align-items: center;
  }
</style>
