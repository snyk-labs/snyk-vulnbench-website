---
import RepresentativeCases from "../../../components/evidence/RepresentativeCases.astro";
import PageHero from "../../../components/site/PageHero.astro";
import ReleaseMeta from "../../../components/site/ReleaseMeta.astro";
import { loadJs10EvidenceDepth } from "../../../data/evidence/js-1.0";
import { currentRelease } from "../../../data/releases";
import { loadJs10PublishedEvidence } from "../../../data/releases/js-1.0-source";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const evidence = await loadJs10PublishedEvidence();
const evidenceDepth = await loadJs10EvidenceDepth();
---

<BaseLayout
  title="JS 1.0 Cases"
  description="Inspect representative Snyk VulnBench JS 1.0 cases showing false-positive-shaped reports, likely product gaps, and systematic coverage gaps."
  release={currentRelease}
>
  <PageHero
    eyebrow="JS 1.0 · Representative cases"
    title="Inspect representative JS 1.0 cases"
    description="Move from aggregate behavior to concrete source patterns. These cases explain why unmatched reports require inspection and why stable model output can remain incomplete."
  >
    <div slot="actions" class="button-row">
      <a class="button" href={currentRelease.links.overview}>Release overview</a>
      <a class="button secondary" href={currentRelease.links.methodology}
        >Matching methodology</a
      >
    </div>
    <ReleaseMeta slot="aside" release={currentRelease} />
  </PageHero>

  <section class="section context">
    <div class="container context-grid">
      <div>
        <p class="eyebrow">Case context</p>
        <h2>Small fixtures make divergent evidence inspectable</h2>
      </div>
      <div class="prose">
        <p>
          Tigerteam is a compact JavaScript application containing deliberate
          vulnerability-shaped patterns. Nightowl is the largest app-like JS
          1.0 fixture, with routes, uploads, database state, attachment flows,
          and frontend JavaScript.
        </p>
        <p>
          Snyk Code defines the release reference set. Model matches and misses
          below are interpreted against that set; unmatched reports are not
          automatically false positives.
        </p>
      </div>
    </div>
  </section>

  <section class="section cases-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Published case evidence</p>
        <h2>Similar report labels can require opposite conclusions</h2>
        <p class="lede">
          SQL-shaped reports in two fixtures recurred identically, but source
          inspection separates a non-executable decoy from a likely
          deterministic-reference gap.
        </p>
      </div>
      <RepresentativeCases cases={evidence.cases} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">All benchmark projects</p>
        <h2>Inspect project evidence</h2>
        <p class="lede">
          Open reference findings, normalized model evidence, recurrence, and
          licensed source context for each JS 1.0 fixture.
        </p>
      </div>
      <ol class="project-catalog">
        {
          evidenceDepth.projects.map((project) => (
            <li>
              <div>
                <h3>
                  <a href={`/releases/js-1.0/cases/${project.id}`}>
                    {project.name}
                  </a>
                </h3>
                <p>{project.description}</p>
              </div>
              <span class="metric">
                {project.referenceFindings.length} reference findings
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section source-note">
    <div class="container">
      <p class="eyebrow">Evidence boundary</p>
      <h2>Cases support interpretation, not universal classification</h2>
      <p>
        These static Phase 1 cases summarize published evidence from dataset
        <span class="metric">1.0.0</span>. The implemented Findings explorer and
        project routes provide normalized signatures, recurrence, and licensed
        source context for deeper inspection.
      </p>
      <div class="button-row">
        <a class="button" href="/releases/js-1.0/explore?v=1&view=findings"
          >Explore normalized findings</a
        >
        <a class="button secondary" href={currentRelease.links.data}
          >Download the published evidence</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .context-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr);
  }

  .context h2,
  .source-note h2 {
    max-width: 17ch;
    margin-top: var(--space-2);
  }

  .cases-section {
    background: var(--paper-muted);
  }

  .source-note {
    background: var(--purple-soft);
  }

  .project-catalog {
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .project-catalog li {
    display: grid;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
    gap: var(--space-3);
  }

  .project-catalog p {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }

  .project-catalog > li > .metric {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .source-note p:not(.eyebrow) {
    max-width: 48rem;
    margin-top: var(--space-3);
  }

  .source-note .text-link {
    margin-top: var(--space-4);
  }

  @media (min-width: 58rem) {
    .context-grid {
      grid-template-columns: 0.7fr 1.3fr;
      gap: var(--space-8);
    }

    .project-catalog li {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
  }
</style>
