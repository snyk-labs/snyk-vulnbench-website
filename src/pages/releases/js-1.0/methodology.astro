---
import PageHero from "../../../components/site/PageHero.astro";
import ReleaseMeta from "../../../components/site/ReleaseMeta.astro";
import { currentRelease } from "../../../data/releases";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="JS 1.0 Methodology"
  description="Benchmark design, matching protocol, metric definitions, limitations, and reproducibility guidance for Snyk VulnBench JS 1.0."
>
  <PageHero
    eyebrow="JS 1.0 · Methodology"
    title="A controlled repeatability and agreement study"
    description="The protocol keeps code, prompt, harness, and task constant across repeated runs, then measures recurrence and agreement against a deterministic Snyk Code reference set."
  >
    <div slot="actions" class="button-row">
      <a class="button" href={currentRelease.links.paper}>Read the full paper</a>
      <a class="button secondary" href={currentRelease.links.data}
        >Inspect source data</a
      >
    </div>
    <ReleaseMeta slot="aside" release={currentRelease} />
  </PageHero>

  <article>
    <section class="section">
      <div class="container methodology-grid">
        <nav class="contents" aria-label="On this page">
          <p class="eyebrow">On this page</p>
          <ol>
            <li><a href="#design">Benchmark design</a></li>
            <li><a href="#matching">Reference matching</a></li>
            <li><a href="#metrics">Metric definitions</a></li>
            <li><a href="#limitations">Limitations</a></li>
            <li><a href="#reproduction">Reproduction</a></li>
          </ol>
        </nav>

        <div class="prose">
          <section id="design">
            <p class="eyebrow">01 · Benchmark design</p>
            <h2>300 scans under repeated conditions</h2>
            <p>
              The benchmark contains ten small JavaScript and Express fixture
              projects with 44 Snyk Code reference findings. Six
              configurations ran every task five times, producing 300 total
              scans: 250 model runs and 50 deterministic Snyk Code runs.
            </p>
            <p>
              Model configurations used the same direct audit prompt through a
              Claude Code harness and returned structured findings. They could
              read project files but not each fixture’s reference
              <code>findings.json</code>.
            </p>
          </section>

          <section id="matching">
            <p class="eyebrow">02 · Reference matching</p>
            <h2>Agreement uses a deliberately lenient scorer</h2>
            <p>
              A model finding receives reference credit when it reports the
              same vulnerability type as a Snyk Code finding. It does not need
              to identify the same file, line, severity, or exact
              source-to-sink path.
            </p>
            <aside class="critical-caveat">
              <strong>Protocol boundary</strong>
              <p>
                Snyk Code defines the reference set. Its 100% result means it
                deterministically reproduced that set; it is not a claim that
                Snyk Code found every vulnerability in the projects.
              </p>
            </aside>
          </section>

          <section id="metrics">
            <p class="eyebrow">03 · Metric definitions</p>
            <h2>Each value answers a narrow question</h2>
            <dl class="metrics">
              {
                currentRelease.metrics.map((metric) => (
                  <div>
                    <dt>{metric.label}</dt>
                    <dd>
                      <p>{metric.definition}</p>
                      <span>
                        <strong>Unit:</strong> {metric.unit} ·{" "}
                        <strong>Aggregation:</strong> {metric.aggregation}
                      </span>
                      <small>{metric.caveat}</small>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </section>

          <section id="limitations">
            <p class="eyebrow">04 · Limitations</p>
            <h2>What the protocol cannot establish</h2>
            <ul>
              {
                currentRelease.caveats.map((caveat) => (
                  <li>{caveat}</li>
                ))
              }
            </ul>
          </section>

          <section id="reproduction">
            <p class="eyebrow">05 · Reproduction</p>
            <h2>Trace the release to immutable source artifacts</h2>
            <p>
              The website vendors the exact upstream source tree at commit
              <code>7c944ea438a31ea4cbd6803f1bb9560d01f932e5</code>. Its
              JSONL results, fixture references, generated visualizations, and
              Git blob manifest are available through the data page.
            </p>
            <p>
              <a class="text-link" href={currentRelease.links.data}
                >Open data and provenance</a
              >
            </p>
          </section>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .methodology-grid {
    display: grid;
    gap: var(--space-7);
  }

  .contents {
    align-self: start;
    padding: var(--space-4);
    border-top: 0.3rem solid var(--purple);
    background: var(--paper-muted);
  }

  .contents ol {
    display: grid;
    padding-left: 1.25rem;
    margin-top: var(--space-3);
    gap: var(--space-2);
    font-size: var(--step--1);
  }

  .prose section + section {
    padding-top: var(--space-7);
    margin-top: var(--space-7);
    border-top: 1px solid var(--rule);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    overflow-wrap: anywhere;
  }

  .critical-caveat {
    padding: var(--space-4);
    margin-top: var(--space-5);
    border: 1px solid var(--warning);
    background: var(--warning-soft);
  }

  .critical-caveat p {
    margin-top: var(--space-2);
  }

  .metrics {
    margin-top: var(--space-5);
    border-top: 1px solid var(--ink);
  }

  .metrics > div {
    display: grid;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
    gap: var(--space-3);
  }

  .metrics dt {
    font-weight: 750;
  }

  .metrics dd {
    margin: 0;
  }

  .metrics span,
  .metrics small {
    display: block;
    margin-top: var(--space-2);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  #limitations ul {
    display: grid;
    padding-left: 1.25rem;
    gap: var(--space-2);
  }

  @media (min-width: 58rem) {
    .methodology-grid {
      grid-template-columns: 15rem minmax(0, 1fr);
    }

    .contents {
      position: sticky;
      top: 1rem;
    }

    .metrics > div {
      grid-template-columns: 13rem 1fr;
    }
  }
</style>
