---
import PageHero from "../../../components/site/PageHero.astro";
import ReleaseMeta from "../../../components/site/ReleaseMeta.astro";
import {
  JS10_FIXTURE_SLOC,
  webApplicationReferences,
} from "../../../data/explorer/resource-projection";
import { currentRelease } from "../../../data/releases";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="JS 1.0 Methodology"
  description="Benchmark design, matching protocol, metric definitions, limitations, and reproducibility guidance for Snyk VulnBench JS 1.0."
  release={currentRelease}
>
  <PageHero
    eyebrow="JS 1.0 · Methodology"
    title="A controlled repeatability and agreement study"
    description="The protocol keeps code, prompt, harness, and task constant across repeated runs, then measures recurrence and agreement against a deterministic Snyk Code reference set."
  >
    <div slot="actions" class="button-row">
      <a class="button" href={currentRelease.links.paper}>Read the full paper</a>
      <a class="button secondary" href={currentRelease.links.data}
        >Inspect source data</a
      >
    </div>
    <ReleaseMeta slot="aside" release={currentRelease} />
  </PageHero>

  <article>
    <section class="section">
      <div class="container methodology-grid">
        <nav class="contents" aria-label="On this page">
          <p class="eyebrow">On this page</p>
          <ol>
            <li><a href="#design">Benchmark design</a></li>
            <li><a href="#matching">Reference matching</a></li>
            <li><a href="#metrics">Metric definitions</a></li>
            <li><a href="#resource-projections">Resource projections</a></li>
            <li><a href="#limitations">Limitations</a></li>
            <li><a href="#reproduction">Reproduction</a></li>
          </ol>
        </nav>

        <div class="prose">
          <section id="design">
            <p class="eyebrow">01 · Benchmark design</p>
            <h2>300 scans under repeated conditions</h2>
            <p>
              The benchmark contains ten small JavaScript and Express fixture
              projects with 44 Snyk Code reference findings. Six
              configurations ran every task five times, producing 300 total
              scans: 250 model runs and 50 deterministic Snyk Code runs.
            </p>
            <p>
              Model configurations used the same direct audit prompt through a
              Claude Code harness and returned structured findings. They could
              read project files but not each fixture’s reference
              <code>findings.json</code>.
            </p>
          </section>

          <section id="matching">
            <p class="eyebrow">02 · Reference matching</p>
            <h2>Agreement uses a deliberately lenient scorer</h2>
            <p>
              A model finding receives reference credit when it reports the
              same vulnerability type as a Snyk Code finding. It does not need
              to identify the same file, line, severity, or exact
              source-to-sink path.
            </p>
            <aside class="critical-caveat">
              <strong>Protocol boundary</strong>
              <p>
                Snyk Code defines the reference set. Its 100% result means it
                deterministically reproduced that set; it is not a claim that
                Snyk Code found every vulnerability in the projects.
              </p>
            </aside>
          </section>

          <section id="metrics">
            <p class="eyebrow">03 · Metric definitions</p>
            <h2>Each value answers a narrow question</h2>
            <dl class="metrics">
              {
                currentRelease.metrics.map((metric) => (
                  <div>
                    <dt>{metric.label}</dt>
                    <dd>
                      <p>{metric.definition}</p>
                      <span>
                        <strong>Unit:</strong> {metric.unit} ·{" "}
                        <strong>Aggregation:</strong> {metric.aggregation}
                      </span>
                      <small>{metric.caveat}</small>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </section>

          <section id="resource-projections">
            <p class="eyebrow">04 · Resource projections</p>
            <h2>A release-wide linear extrapolation</h2>
            <p>
              The Explorer labels these values <strong>Projected</strong>:
              they are not completed scans of the application references. The
              lower Efficiency figure remains <strong>Observed</strong>
              benchmark evidence, including Snyk-reference F1 as reference
              agreement rather than universal detection accuracy.
            </p>
            <p>
              For each configuration and resource metric, the release resource
              total is the sum of the ten published per-fixture mean session
              resource values. The resource rate per 1,000 SLOC is that total
              divided by 1.154; projected application resource is the rate
              multiplied by the application SLOC and divided by 1,000. Rates
              always use the complete release matrix, not the currently
              filtered fixture subset; filters determine only which
              configuration lines are visible.
            </p>
            <dl class="projection-formula">
              <div>
                <dt>Fixture denominator</dt>
                <dd>
                  {JS10_FIXTURE_SLOC.toLocaleString("en-US")} SLOC across the
                  JS 1.0 fixtures, counted with <code>cloc 2.06</code> across
                  JavaScript, TypeScript, JSX/TSX, CSS/SCSS, HTML, and
                  Handlebars.
                </dd>
              </div>
              <div>
                <dt>Excluded from the denominator</dt>
                <dd>
                  Package manifests, lockfiles, dependencies, comments, and
                  blank lines.
                </dd>
              </div>
              <div>
                <dt>Resource semantics</dt>
                <dd>
                  Cost uses estimated API-equivalent model-session USD; tokens
                  use mean total tokens; duration uses mean wall-clock seconds.
                  Snyk Code has no comparable model-session cost or token
                  value.
                </dd>
              </div>
            </dl>
            <h3>Pinned web-application size references</h3>
            <p>
              <code>cloc 2.06</code> measured production application code on
              the following pinned upstream revisions on 2026-08-29. The
              counts include browser and server application code and exclude
              tests, documentation, dependencies, generated output, fixtures,
              mocks, and build artifacts.
            </p>
            <div class="projection-references">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Application</th>
                    <th scope="col">Pinned upstream revision</th>
                    <th scope="col">Production SLOC</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    webApplicationReferences.map((reference) => (
                      <tr>
                        <th scope="row">{reference.name}</th>
                        <td>
                          <a
                            class="text-link"
                            href={`${reference.repositoryUrl}/commit/${reference.commit}`}
                          >
                            <code>{reference.commit}</code>
                          </a>
                        </td>
                        <td>{reference.sloc.toLocaleString("en-US")}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <aside class="critical-caveat">
              <strong>Projection limit</strong>
              <p>
                This deliberately simple linear extrapolation does not model
                context-window boundaries, repository indexing, incremental
                scans, parallel execution, deduplication, caching changes,
                model price changes, or economies of scale. A full-codebase
                scan does not guarantee finding every vulnerability.
              </p>
            </aside>
          </section>

          <section id="limitations">
            <p class="eyebrow">05 · Limitations</p>
            <h2>What the protocol cannot establish</h2>
            <ul>
              {
                currentRelease.caveats.map((caveat) => (
                  <li>{caveat}</li>
                ))
              }
            </ul>
          </section>

          <section id="reproduction">
            <p class="eyebrow">06 · Reproduction</p>
            <h2>Trace the release to immutable source artifacts</h2>
            <p>
              The website vendors the exact upstream source tree at commit
              <code>7c944ea438a31ea4cbd6803f1bb9560d01f932e5</code>. Its
              JSONL results, fixture references, generated visualizations, and
              Git blob manifest are available through the data page.
            </p>
            <p>
              <a class="text-link" href={currentRelease.links.data}
                >Open data and provenance</a
              >
            </p>
          </section>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .methodology-grid {
    display: grid;
    gap: var(--space-7);
  }

  .contents {
    align-self: start;
    padding: var(--space-4);
    border-top: 0.3rem solid var(--purple);
    background: var(--paper-muted);
  }

  .contents ol {
    display: grid;
    padding-left: 1.25rem;
    margin-top: var(--space-3);
    gap: var(--space-2);
    font-size: var(--step--1);
  }

  .prose section + section {
    padding-top: var(--space-7);
    margin-top: var(--space-7);
    border-top: 1px solid var(--rule);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    overflow-wrap: anywhere;
  }

  .critical-caveat {
    padding: var(--space-4);
    margin-top: var(--space-5);
    border: 1px solid var(--warning);
    background: var(--warning-soft);
  }

  .critical-caveat p {
    margin-top: var(--space-2);
  }

  .metrics {
    margin-top: var(--space-5);
    border-top: 1px solid var(--ink);
  }

  .metrics > div {
    display: grid;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
    gap: var(--space-3);
  }

  .metrics dt {
    font-weight: var(--font-weight-label-strong);
  }

  .projection-formula {
    margin-top: var(--space-5);
    border-top: 1px solid var(--ink);
  }

  .projection-formula > div {
    display: grid;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
    gap: var(--space-2);
  }

  .projection-formula dt {
    font-weight: var(--font-weight-label-strong);
  }

  .projection-formula dd {
    margin: 0;
  }

  .projection-references {
    max-width: 100%;
    margin-top: var(--space-4);
    overflow-x: auto;
    border: 1px solid var(--rule);
  }

  .projection-references table {
    width: 100%;
    min-width: 42rem;
    border-collapse: collapse;
    text-align: left;
  }

  .projection-references th,
  .projection-references td {
    padding: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }

  .projection-references tbody tr:last-child th,
  .projection-references tbody tr:last-child td {
    border-bottom: 0;
  }

  .metrics dd {
    margin: 0;
  }

  .metrics span,
  .metrics small {
    display: block;
    margin-top: var(--space-2);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  #limitations ul {
    display: grid;
    padding-left: 1.25rem;
    gap: var(--space-2);
  }

  @media (min-width: 58rem) {
    .methodology-grid {
      grid-template-columns: 15rem minmax(0, 1fr);
    }

    .contents {
      position: sticky;
      top: 1rem;
    }

    .metrics > div {
      grid-template-columns: 13rem 1fr;
    }

    .projection-formula > div {
      grid-template-columns: 13rem 1fr;
    }
  }
</style>
