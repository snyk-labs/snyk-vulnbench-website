---
import { ExplorerApp } from "../../../components/explorer/ExplorerApp";
import PageHero from "../../../components/site/PageHero.astro";
import ReleaseMeta from "../../../components/site/ReleaseMeta.astro";
import { loadJs10ExplorerDataset } from "../../../data/explorer/js-1.0";
import { currentRelease } from "../../../data/releases";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const explorerDataset = await loadJs10ExplorerDataset();
---

<BaseLayout
  title="Explore JS 1.0"
  description="Inspect the published Snyk VulnBench JS 1.0 recurrence evidence and its scientific context."
  release={currentRelease}
>
  <PageHero
    eyebrow="JS 1.0 · Interactive explorer"
    title="Test the published conclusions against the evidence"
    description="Filter configurations and projects, move between guided analytical views, compare up to four configurations, and share deterministic explorer state."
  >
    <div slot="actions" class="button-row">
      <a class="button" href="#explorer-workbench">Open the workbench</a>
      <a class="button secondary" href={currentRelease.links.overview}
        >Read the release narrative</a
      >
    </div>
    <ReleaseMeta slot="aside" release={currentRelease} />
  </PageHero>

  <section id="explorer-workbench">
    <ExplorerApp
      dataset={explorerDataset}
      initialSearch=""
      client:load
    />
  </section>
</BaseLayout>

<style>
  #explorer-workbench {
    border-top: 1px solid var(--ink);
  }
</style>
