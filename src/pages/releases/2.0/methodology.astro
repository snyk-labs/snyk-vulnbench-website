---
import DataTable from "../../../components/release-2.0/DataTable.astro";
import Disclosure from "../../../components/release-2.0/Disclosure.astro";
import PaperFigure from "../../../components/release-2.0/PaperFigure.astro";
import {
  configurationSpecs,
  corpusSpec,
  type TableSpec,
} from "../../../components/release-2.0/evidence-tables";
import PageHero from "../../../components/site/PageHero.astro";
import ReleaseMeta from "../../../components/site/ReleaseMeta.astro";
import { requireReleaseBySlug } from "../../../data/releases";
import { v20Copy } from "../../../data/releases/2.0-content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { release20SocialImage } from "../../../config/design-theme";

const release = requireReleaseBySlug("2.0");
const { methodology, terms } = v20Copy;

const sectionLabels: Record<string, string> = {
  design: "Benchmark design",
  reference: "Reference set",
  configurations: "Configurations",
  protocol: "Protocol",
  scoring: "Scoring",
  metrics: "Metric definitions",
  supplementary: "Supplementary runs",
  limitations: "Limitations",
  reproduction: "Reproduction",
};
const tablesFor: Record<string, TableSpec[]> = {
  "data/tables/corpus_by_language.csv": [corpusSpec()],
  "data/tables/configurations.csv": configurationSpecs(),
};
const sections = methodology.sections.map((section, index) => {
  const label = sectionLabels[section.id];
  if (!label) throw new Error(`No contents label for methodology section ${section.id}`);
  return {
    ...section,
    label,
    marker: String(index + 1).padStart(2, "0"),
    tables: section.table ? (tablesFor[section.table] ?? []) : [],
  };
});
---

<BaseLayout
  title={methodology.title}
  description={methodology.lede}
  image={release20SocialImage}
  release={release}
>
  <PageHero eyebrow={methodology.title} title={methodology.h1} description={methodology.lede}>
    <div slot="actions" class="button-row">
      <a class="button" href={release.links.paper}>Read the paper</a>
      <a class="button secondary" href={release.links.data}>Inspect source data</a>
    </div>
    <ReleaseMeta slot="aside" release={release} />
  </PageHero>

  <div class="methodology-header container">
    <Disclosure form="long" />
  </div>

  <article>
    <section class="section">
      <div class="container methodology-grid">
        <nav class="contents" aria-label="On this page">
          <p class="eyebrow">On this page</p>
          <ol>
            {sections.map(({ id, label }) => <li><a href={`#${id}`}>{label}</a></li>)}
            <li><a href="#terms">Terms</a></li>
          </ol>
        </nav>

        <div class="prose">
          {
            sections.map((section) => (
              <section id={section.id}>
                <p class="eyebrow">
                  {section.marker} · {section.label}
                </p>
                <h2>{section.h2}</h2>
                {section.body?.map((paragraph) => <p>{paragraph}</p>)}
                {section.metrics && (
                  <dl class="metrics">
                    {section.metrics.map((metric) => (
                      <div>
                        <dt>{metric.name}</dt>
                        <dd>
                          <p>{metric.definition}</p>
                          <span>
                            <strong>Unit:</strong> {metric.unit} ·{" "}
                            <strong>Aggregation:</strong> {metric.aggregation}
                          </span>
                          <small>{metric.caveat}</small>
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
                {section.list_from === "limitations" && (
                  <ul>
                    {release.caveats.map((caveat) => <li>{caveat}</li>)}
                  </ul>
                )}
                {section.tables.map((spec) => (
                  <DataTable {...spec} collapsible={false} />
                ))}
                {section.figure && <PaperFigure number={section.figure} />}
                {section.id === "reproduction" && (
                  <p>
                    <a class="text-link" href={release.links.data}>
                      Open data and provenance
                    </a>
                  </p>
                )}
              </section>
            ))
          }

          <section id="terms">
            <p class="eyebrow">Terms</p>
            <h2>Plain-language terms</h2>
            <dl class="metrics">
              {
                terms.map(([term, definition]) => (
                  <div>
                    <dt>{term}</dt>
                    <dd>
                      <p>{definition}</p>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </section>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .methodology-header {
    padding-block: var(--space-5) 0;
  }

  .methodology-grid {
    display: grid;
    gap: var(--space-7);
  }

  .methodology-grid > * {
    min-width: 0;
  }

  .contents {
    align-self: start;
    padding: var(--space-4);
    border-top: 0.3rem solid var(--purple);
    background: var(--paper-muted);
  }

  .contents ol {
    display: grid;
    padding-left: 1.25rem;
    margin-top: var(--space-3);
    gap: var(--space-2);
    font-size: var(--step--1);
  }

  .prose section {
    min-width: 0;
  }

  .prose section + section {
    padding-top: var(--space-7);
    margin-top: var(--space-7);
    border-top: 1px solid var(--rule);
  }

  .metrics {
    margin-top: var(--space-5);
    border-top: 1px solid var(--ink);
  }

  .metrics > div {
    display: grid;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
    gap: var(--space-3);
  }

  .metrics dt {
    font-weight: var(--font-weight-label-strong);
  }

  .metrics dd {
    margin: 0;
  }

  .metrics span,
  .metrics small {
    display: block;
    margin-top: var(--space-2);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  #limitations ul {
    display: grid;
    padding-left: 1.25rem;
    gap: var(--space-2);
  }

  @media (min-width: 58rem) {
    .methodology-grid {
      grid-template-columns: 15rem minmax(0, 1fr);
    }

    .contents {
      position: sticky;
      top: 1rem;
    }

    .metrics > div {
      grid-template-columns: 13rem 1fr;
    }
  }
</style>
