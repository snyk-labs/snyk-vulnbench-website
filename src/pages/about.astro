---
import Disclosure from "../components/release-2.0/Disclosure.astro";
import PageHero from "../components/site/PageHero.astro";
import ReleaseCitation from "../components/site/ReleaseCitation.astro";
import { requireReleaseBySlug } from "../data/releases";
import { v20Copy } from "../data/releases/2.0-content";
import BaseLayout from "../layouts/BaseLayout.astro";

const v20Release = requireReleaseBySlug("2.0");
const js10Release = requireReleaseBySlug("js-1.0");
const js10Citation = `${js10Release.citation.authors.join(", ")}. “${js10Release.citation.title}.” arXiv, ${js10Release.citation.year}.`;
const [, v20DatasetGuidance] = v20Copy.citation.guidance.split(/(?<=score\.) /u);
const teams = [
  {
    release: v20Release,
    members: v20Copy.citation.team_2_0.map((entry) => {
      const [name = entry, affiliation = ""] = entry.split(" · ");
      return { name, affiliation };
    }),
  },
  {
    release: js10Release,
    members: js10Release.citation.authors.map((name) => ({ name, affiliation: "Snyk" })),
  },
];
---

<BaseLayout
  title="About"
  description="The scope, principles, team, version policy, and citation guidance for the Snyk VulnBench benchmark initiative."
  image="/social/2.0/release.svg"
>
  <PageHero
    eyebrow="About VulnBench"
    title="A durable home for inspectable benchmark evidence"
    description="Snyk VulnBench publishes versioned studies of vulnerability-finding behavior, their methods, datasets, cases, and interpretation boundaries."
  />

  <section class="section">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">Product promise</p>
        <h2>Explore the result. Inspect the evidence.</h2>
      </div>
      <div class="prose">
        <p class="lede">
          Explore how reliably AI systems find vulnerabilities—and inspect the
          evidence behind every conclusion.
        </p>
        <p>
          VulnBench is not a universal leaderboard, a live scanner, or the home
          for all Snyk AI security research. It is one benchmark initiative
          spanning versioned protocols and stable public releases.
        </p>
      </div>
    </div>
  </section>

  <section class="section principles">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">Initiative principles</p>
        <h2>Scientific framing stays in the interface</h2>
      </div>
      <ol>
        <li><strong>Evidence before ranking.</strong> Lead with measured behavior.</li>
        <li>
          <strong>Precise language.</strong> Reference agreement is not renamed
          accuracy.
        </li>
        <li>
          <strong>Every value has provenance.</strong> Release, dataset, metric,
          aggregation, and sample size travel together.
        </li>
        <li>
          <strong>Version boundaries are explicit.</strong> Incompatible
          protocols do not produce false comparisons.
        </li>
        <li>
          <strong>Immutable releases.</strong> Corrections are documented rather
          than silently rewritten.
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">Team</p>
        <h2>Researchers and authors</h2>
      </div>
      <div class="teams">
        {
          teams.map(({ release, members }) => (
            <div class="team-release">
              <h3>{release.name}</h3>
              <ul class="team">
                {members.map(({ name, affiliation }) => (
                  <li>
                    <strong>{name}</strong>
                    <span>{affiliation}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section disclosure-section">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">{v20Release.name}</p>
        <h2>Disclosure</h2>
      </div>
      <Disclosure form="long" />
    </div>
  </section>

  <section class="section citation-section" id="citation">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">Citation guidance</p>
        <h2>Cite the release, not an unversioned score</h2>
      </div>
      <div class="citations">
        <div class="citation-entry">
          <ReleaseCitation release={v20Release} plain={v20Copy.citation.plain_2_0} />
          <p>{v20DatasetGuidance}</p>
          <a class="text-link" href={v20Release.links.paper}
            >Open the canonical paper</a
          >
        </div>
        <div class="citation-entry">
          <ReleaseCitation release={js10Release} plain={js10Citation} />
          <p>
            Include the release name and dataset version
            <span class="metric">{js10Release.datasetVersion}</span> when
            reproducing a chart or filtered result.
          </p>
          <a class="text-link" href={js10Release.links.paper}
            >Open the canonical paper</a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: var(--space-6);
  }

  .about-grid h2 {
    max-width: 15ch;
    margin-top: var(--space-2);
  }

  .principles {
    background: var(--paper-muted);
  }

  .principles ol {
    display: grid;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .principles li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule-strong);
  }

  .team {
    display: grid;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .team li {
    display: grid;
    padding: var(--space-4);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .team span {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .citation-section {
    background: var(--purple-soft);
  }

  .teams,
  .citations {
    display: grid;
    min-width: 0;
    gap: var(--space-5);
  }

  .team-release h3 {
    margin-bottom: var(--space-3);
    font-size: var(--step-1);
  }

  .citation-entry {
    display: grid;
    min-width: 0;
    gap: var(--space-3);
    justify-items: start;
  }

  .citation-entry > p {
    color: var(--ink-soft);
  }

  @media (min-width: 56rem) {
    .about-grid {
      grid-template-columns: 0.65fr 1.35fr;
      gap: var(--space-8);
    }
  }
</style>
